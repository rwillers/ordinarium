{
  "name": "ordinarium-cloudflare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:assets": "node scripts/build-assets.mjs",
    "precheck": "npm run build:assets",
    "check": "tsc --noEmit && wrangler deploy --dry-run && wrangler deploy --dry-run --config wrangler.alerts.jsonc",
    "predeploy": "npm run build:assets",
    "deploy": "wrangler deploy",
    "deploy:alerts": "wrangler deploy --config wrangler.alerts.jsonc",
    "test": "node --test src/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "queues:ensure": "node scripts/ensure-queues.mjs"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260717.1",
    "typescript": "7.0.2",
    "wrangler": "4.112.0"
  }
}
