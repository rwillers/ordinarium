{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ordinarium-alerts-staging",
  "main": "src/alert_tail.ts",
  "compatibility_date": "2026-07-17",
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "ALERT_DEDUPE_WINDOW_SECONDS": "900"
  },
  "queues": {
    "producers": [
      {
        "binding": "ALERTS_QUEUE",
        "queue": "ordinarium-app-staging-alerts"
      }
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ALERT_DEDUPLICATOR",
        "class_name": "AlertDeduplicator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AlertDeduplicator"]
    }
  ]
}
