{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ordinarium-app-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-17",
  "containers": [
    {
      "name": "ordinarium-web",
      "class_name": "WebContainer",
      "image": "../containers/web/Dockerfile",
      "image_build_context": "..",
      "instance_type": "basic",
      "max_instances": 1
    },
    {
      "name": "ordinarium-documents",
      "class_name": "DocumentContainer",
      "image": "../containers/documents/Dockerfile",
      "image_build_context": "..",
      "instance_type": "standard-1",
      "max_instances": 2
    },
    {
      "name": "ordinarium-pco-jobs",
      "class_name": "PcoJobsContainer",
      "image": "../containers/jobs/Dockerfile",
      "image_build_context": "..",
      "instance_type": "basic",
      "max_instances": 1
    },
    {
      "name": "ordinarium-email-jobs",
      "class_name": "EmailJobsContainer",
      "image": "../containers/jobs/Dockerfile",
      "image_build_context": "..",
      "instance_type": "basic",
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "WEB_CONTAINER",
        "class_name": "WebContainer"
      },
      {
        "name": "DOCUMENT_CONTAINER",
        "class_name": "DocumentContainer"
      },
      {
        "name": "PCO_JOBS_CONTAINER",
        "class_name": "PcoJobsContainer"
      },
      {
        "name": "EMAIL_JOBS_CONTAINER",
        "class_name": "EmailJobsContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "WebContainer",
        "DocumentContainer",
        "PcoJobsContainer",
        "EmailJobsContainer"
      ]
    }
  ],
  "dev": {
    "enable_containers": true
  }
}
