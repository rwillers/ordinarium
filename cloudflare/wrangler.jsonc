{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ordinarium-app-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-17",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": false
  },
  "workers_dev": false,
  "routes": [
    {
      "pattern": "containers-staging.ordinarium.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "DEPLOYMENT_ENV": "staging"
  },
  "d1_databases": [
    {
      "binding": "APP_DB",
      "database_name": "ordinarium-app-staging",
      "database_id": "e13336d8-cf7c-4c63-955d-4d8c7cfa4321",
      "migrations_dir": "../migrations/d1"
    }
  ],
  "containers": [
    {
      "name": "ordinarium-web",
      "class_name": "WebContainer",
      "image": "../containers/web/Dockerfile",
      "image_build_context": "..",
      "instance_type": "basic",
      "max_instances": 1
    },
    {
      "name": "ordinarium-documents",
      "class_name": "DocumentContainer",
      "image": "../containers/documents/Dockerfile",
      "image_build_context": "..",
      "instance_type": "standard-1",
      "max_instances": 2
    },
    {
      "name": "ordinarium-pco-jobs",
      "class_name": "PcoJobsContainer",
      "image": "../containers/jobs/Dockerfile",
      "image_build_context": "..",
      "instance_type": "basic",
      "max_instances": 1
    },
    {
      "name": "ordinarium-email-jobs",
      "class_name": "EmailJobsContainer",
      "image": "../containers/jobs/Dockerfile",
      "image_build_context": "..",
      "instance_type": "basic",
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "WEB_CONTAINER",
        "class_name": "WebContainer"
      },
      {
        "name": "DOCUMENT_CONTAINER",
        "class_name": "DocumentContainer"
      },
      {
        "name": "PCO_JOBS_CONTAINER",
        "class_name": "PcoJobsContainer"
      },
      {
        "name": "EMAIL_JOBS_CONTAINER",
        "class_name": "EmailJobsContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "WebContainer",
        "DocumentContainer",
        "PcoJobsContainer",
        "EmailJobsContainer"
      ]
    }
  ],
  "dev": {
    "enable_containers": true
  }
}
