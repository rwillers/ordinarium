{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ordinarium-app-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-17",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": false
  },
  "workers_dev": false,
  "routes": [
    {
      "pattern": "staging.ordinarium.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "tail_consumers": [
    {
      "service": "ordinarium-alerts-staging"
    }
  ],
  "vars": {
    "DEPLOYMENT_ENV": "staging",
    "APP_ORIGIN": "https://staging.ordinarium.com",
    "SIDE_EFFECTS_HOSTNAME": "staging.ordinarium.com",
    "EXTERNAL_SIDE_EFFECTS_ENABLED": "true",
    "TURNSTILE_SITE_KEY": "0x4AAAAAACNe-sQcXR2N-BAL",
    "TURNSTILE_EXPECTED_HOSTNAME": "staging.ordinarium.com",
    "ALERT_EMAIL_TO": "ryanwillers+ordo@gmail.com"
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "d1_databases": [
    {
      "binding": "APP_DB",
      "database_name": "ordinarium-app-staging",
      "database_id": "e13336d8-cf7c-4c63-955d-4d8c7cfa4321",
      "migrations_dir": "../migrations/d1"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "PCO_JOBS_QUEUE",
        "queue": "ordinarium-app-staging-pco-jobs"
      },
      {
        "binding": "EMAIL_JOBS_QUEUE",
        "queue": "ordinarium-app-staging-email-jobs"
      },
      {
        "binding": "PCO_JOBS_DLQ",
        "queue": "ordinarium-app-staging-pco-jobs-dlq"
      },
      {
        "binding": "EMAIL_JOBS_DLQ",
        "queue": "ordinarium-app-staging-email-jobs-dlq"
      }
    ],
    "consumers": [
      {
        "queue": "ordinarium-app-staging-pco-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 5,
        "dead_letter_queue": "ordinarium-app-staging-pco-jobs-dlq",
        "max_concurrency": 1
      },
      {
        "queue": "ordinarium-app-staging-pco-jobs-dlq",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 100,
        "max_concurrency": 1
      },
      {
        "queue": "ordinarium-app-staging-email-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "ordinarium-app-staging-email-jobs-dlq",
        "max_concurrency": 2
      },
      {
        "queue": "ordinarium-app-staging-email-jobs-dlq",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 100,
        "max_concurrency": 1
      },
      {
        "queue": "ordinarium-app-staging-alerts",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 5,
        "dead_letter_queue": "ordinarium-app-staging-alerts-dlq",
        "max_concurrency": 1
      },
      {
        "queue": "ordinarium-app-staging-alerts-dlq",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 100,
        "max_concurrency": 1
      }
    ]
  },
  "containers": [
    {
      "name": "ordinarium-web",
      "class_name": "WebContainer",
      "image": "../containers/web/Dockerfile",
      "image_build_context": "..",
      "instance_type": "basic",
      "max_instances": 1
    },
    {
      "name": "ordinarium-documents",
      "class_name": "DocumentContainer",
      "image": "../containers/documents/Dockerfile",
      "image_build_context": "..",
      "instance_type": "standard-1",
      "max_instances": 2
    },
    {
      "name": "ordinarium-pco-jobs",
      "class_name": "PcoJobsContainer",
      "image": "../containers/jobs/Dockerfile",
      "image_build_context": "..",
      "instance_type": "basic",
      "max_instances": 1
    },
    {
      "name": "ordinarium-email-jobs",
      "class_name": "EmailJobsContainer",
      "image": "../containers/jobs/Dockerfile",
      "image_build_context": "..",
      "instance_type": "basic",
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "WEB_CONTAINER",
        "class_name": "WebContainer"
      },
      {
        "name": "DOCUMENT_CONTAINER",
        "class_name": "DocumentContainer"
      },
      {
        "name": "PCO_JOBS_CONTAINER",
        "class_name": "PcoJobsContainer"
      },
      {
        "name": "EMAIL_JOBS_CONTAINER",
        "class_name": "EmailJobsContainer"
      },
      {
        "name": "AUTH_RATE_LIMITER",
        "class_name": "AuthRateLimiter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "WebContainer",
        "DocumentContainer",
        "PcoJobsContainer",
        "EmailJobsContainer"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["AuthRateLimiter"]
    }
  ],
  "dev": {
    "enable_containers": true
  }
}
